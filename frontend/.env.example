# Backend address. Publicly reachable: a browser or a phone dials it too.
VITE_API_URL=http://localhost:8000

# Optional shortcut for the SvelteKit server's own hop. Docker sets it to
# http://app:8000; elsewhere VITE_API_URL is right.
# API_URL=

# Optional, tells this instance apart in tabs (see docs/deployment/docker.mdx#instance-branding):
# INSTANCE_BRANDING={"name":"Open Wearables (Staging)","faviconUrl":"https://cdn.example.com/favicon-staging.png"}
