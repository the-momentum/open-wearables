# Backend address, same variable the React frontend uses. Publicly reachable:
# a browser or a phone dials it too.
VITE_API_URL=http://localhost:8000

# Optional shortcut for the SvelteKit server's own hop. Docker sets it to
# http://app:8000; elsewhere VITE_API_URL is right.
# API_URL=

# Sessions: the browser only ever holds an opaque id in an HttpOnly cookie.
# Database 2 keeps them clear of the backend (0) and svix (1).
REDIS_URL=redis://localhost:6379/2
