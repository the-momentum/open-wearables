# Backend API base URL, used by the SvelteKit server only.
#
# Not PUBLIC_: with cookie-backed sessions the browser never calls FastAPI
# directly, so this must not reach the client. Read through
# $env/dynamic/private, which keeps it a runtime value — one prebuilt image can
# be pointed at any backend without rebuilding.
API_URL=http://localhost:8000

# Session store. Sessions hold the access and refresh tokens; the browser only
# ever gets an opaque session id in an HttpOnly cookie.
# Database 2 keeps them clear of the backend (0) and svix (1).
REDIS_URL=redis://localhost:6379/2
