# Copy to .env (ignored) and supply local values. Never commit this file with credentials.
OW_IMAGE_TAG=gadgetbridge-dev
OW_BIND_ADDRESS=127.0.0.1
OW_API_PORT=18000
OW_FRONTEND_PORT=13000
OW_DATA_DIR=/srv/open-wearables
# For LAN access, verify free ports and configure an HTTPS reverse proxy.
API_BASE_URL=http://localhost:18000
FRONTEND_URL=http://localhost:13000
DB_PASSWORD=
SECRET_KEY=
# MASTER_KEY must be a locally generated Fernet key; keep it for database restoration.
MASTER_KEY=
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=
# Replace image tags with immutable @sha256 digests for a reproducible release.
POSTGRES_IMAGE=postgres:18
REDIS_IMAGE=redis:8
PYTHON_IMAGE=python:3.14.7-slim
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.19
BUN_IMAGE=oven/bun:1.4.0-alpine
